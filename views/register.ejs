<%- include('partials/head') %>
<body class="bg-light">
    <%- include('partials/navbar') %>

    <div class="container" style="display: flex; justify-content: center; align-items: center; min-height: 70vh; margin-top: 2rem; margin-bottom: 2rem;">
        <div class="test-card" style="width: 100%; max-width: 450px; padding: 2rem;">
            <h2 style="text-align: center; margin-bottom: 1.5rem; color: var(--dark-blue);">Створення акаунту</h2>
            
            <% if (locals.error) { %>
                <div style="background: #FFEBEE; color: #C62828; padding: 10px; border-radius: 5px; margin-bottom: 15px; text-align: center;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/api/auth/register" method="POST">
                <div class="form-group">
                    <label for="name">Ім'я та Прізвище</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <div class="form-group">
                    <label for="password">Пароль</label>
                    <input type="password" id="password" name="password" required>
                </div>
                <div class="form-group">
                    <label for="role">Хто ви?</label>
                    <select id="role" name="role" class="form-select">
                        <option value="student">Я студент</option>
                        <option value="teacher">Я викладач</option>
                    </select>
                </div>
                <button type="submit" class="btn-primary btn-full">Зареєструватися</button>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>